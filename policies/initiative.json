    {
      "control": "appservice_basic_auth_fix",
      "title": "App Service and Function apps: turn SCM and FTP basic auth off",
      "allowedEffects": [
        "DeployIfNotExists",
        "Disabled"
      ],
      "auditEffect": "Disabled",
      "targetEffect": "DeployIfNotExists",
      "fenrir": [
        "X-10",
        "X-11"
      ],
      "why": "Sets basicPublishingCredentialsPolicies/scm and /ftp to allow=false, so the Kudu path with publishing credentials fails. Remediation, not prevention: there is a window between creation and the fix.",
      "members": [
        {
          "referenceId": "app-scm-basic-auth-fix",
          "definition": "builtin:5e97b776-f380-4722-a9a3-e7f0be029e79",
