{
  "name": "bastion-baseline",
  "displayName": "Bastion baseline",
  "description": "Secure-by-default guardrails for the Bastion landing zone. Built-in definitions wherever one exists. Every effect is a parameter so each control can move from Audit to its target effect on its own.",
  "metadata": {
    "category": "Bastion",
    "version": "1.0.0",
    "builtInsVerifiedAgainst": "github.com/Azure/azure-policy commit f096d8d (2026-10-28)"
  },
  "extraParameters": {
    "listOfAllowedLocations": {
      "type": "Array",
      "metadata": {
        "displayName": "Allowed locations",
        "description": "Regions where Bastion resources may be created."
      }
    },
    "logAnalyticsWorkspaceId": {
      "type": "String",
      "metadata": {
        "displayName": "Log Analytics workspace",
        "description": "Resource ID of law-huginn.",
        "strongType": "omsWorkspace"
      }
    }
  },
  "controls": [
    {
      "control": "storage_shared_key",
      "title": "Storage accounts disable shared key access",
      "allowedEffects": [
        "Audit",
        "Deny",
        "Disabled"
      ],
      "auditEffect": "Audit",
      "targetEffect": "Deny",
      "fenrir": [
        "P-12",
        "D-01",
        "D-02"
      ],
      "why": "With shared keys disabled, the keys returned by listKeys cannot authenticate to the data plane.",
      "members": [
        {
          "referenceId": "storage-shared-key",
          "definition": "builtin:8c6a50c6-9ffd-4ae7-986f-5fa6111f9a54",
          "definitionName": "Storage accounts should prevent shared key access",
          "definitionVersion": "2.1.0",
          "parameters": {
            "effect": "[parameters('effect_storage_shared_key')]"
          }
        }
      ]
    },
    {
