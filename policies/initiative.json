          "referenceId": "func-ftp-basic-auth-audit",
          "definition": "builtin:3357bf2d-1d96-4829-9724-998ef6e7b1d2",
          "definitionName": "Function apps should have local authentication methods disabled for FTP deployments",
          "definitionVersion": "1.0.0",
          "parameters": {
            "effect": "[parameters('effect_appservice_basic_auth_audit')]"
          }
        }
      ]
    },
    {
      "control": "appservice_basic_auth_fix",
      "title": "App Service and Function apps: turn SCM and FTP basic auth off",
      "allowedEffects": [
        "DeployIfNotExists",
        "Disabled"
      ],
      "auditEffect": "Disabled",
      "targetEffect": "DeployIfNotExists",
      "fenrir": [
        "X-10",
        "X-11"
      ],
      "why": "Sets basicPublishingCredentialsPolicies/scm and /ftp to allow=false, so the Kudu path with publishing credentials fails. Remediation, not prevention: there is a window between creation and the fix.",
      "members": [
        {
          "referenceId": "app-scm-basic-auth-fix",
          "definition": "builtin:5e97b776-f380-4722-a9a3-e7f0be029e79",
          "definitionName": "Configure App Service apps to disable local authentication for SCM sites",
          "definitionVersion": "1.1.0",
          "parameters": {
            "effect": "[parameters('effect_appservice_basic_auth_fix')]"
          }
        },
        {
          "referenceId": "app-ftp-basic-auth-fix",
          "definition": "builtin:572e342c-c920-4ef5-be2e-1ed3c6a51dc5",
          "definitionName": "Configure App Service apps to disable local authentication for FTP deployments",
          "definitionVersion": "1.1.0",
          "parameters": {
            "effect": "[parameters('effect_appservice_basic_auth_fix')]"
          }
        },
        {
          "referenceId": "func-scm-basic-auth-fix",
          "definition": "builtin:93059548-9cbe-4cdf-a2d1-63cc8db22550",
          "definitionName": "Configure Function apps to disable local authentication for SCM sites",
          "definitionVersion": "1.0.0",
          "parameters": {
            "effect": "[parameters('effect_appservice_basic_auth_fix')]"
          }
        },
        {
          "referenceId": "func-ftp-basic-auth-fix",
          "definition": "builtin:c7d3e3a0-533b-4ad2-9458-9b28f465ad36",
          "definitionName": "Configure Function apps to disable local authentication for FTP deployments",
          "definitionVersion": "1.0.0",
          "parameters": {
            "effect": "[parameters('effect_appservice_basic_auth_fix')]"
          }
        }
      ]
